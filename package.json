{
  "name": "repotrap",
  "version": "0.0.0",
  "private": true,
  "description": "Static checker that tells you if a GitHub repo is a trap before you clone or open it",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"bench/test/*.test.ts\" \"packages/*/test/*.test.ts\"",
    "bench": "node bench/run-bench.ts",
    "corpus:benign": "node bench/build-benign.ts",
    "corpus:validate": "node bench/validate-manifest.ts corpus/benign.jsonl",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
